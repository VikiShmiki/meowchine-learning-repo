SRA_CLASSIFIER_PATH=data/classifier/rules-v3.json
SRA_RANDOM_SEED=42
SRA_PROJECT_ROOT=.
SRA_SITES_DATA_PATH=data/seed/sites.json
SRA_INFRASTRUCTURE_PATH=data/infrastructure/skopje-2026-09-19
SRA_POLICY_PATH=data/policy/skopje_v1.json
SRA_GUIDANCE_POLICY_PATH=data/policy/skopje_v2.json
# Server-only; copy to ignored .env and restart the service after setting it.
SRA_ORS_API_KEY=

# Server-only OpenAI credential for photo suggestions. Never expose it to the browser.
OPENAI_API_KEY=
SRA_OPENAI_VISION_MODEL=gpt-5.6-luna

# Frozen MiniLM + logistic-regression broad text suggestions. The first local start may
# download the pinned encoder; deployment images bundle it and set SRA_MINILM_MODEL_PATH.
# Local paths must contain verified pinned snapshot bytes; see docs/ML.md for
# cache_encoder commands. Invalid explicit paths disable that language's suggestions.
SRA_MINILM_SUGGESTIONS=true
# SRA_MINILM_MODEL_PATH=/absolute/path/to/all-MiniLM-L6-v2

SRA_COVERAGE_PATH=data/coverage/skopje-v1

SRA_UPGRADES_PATH=data/upgrades/skopje-v1

# Persistent single-instance community reports and paid-request allowances.
SRA_COMMUNITY_DB=runtime/community.sqlite3
# Use a random secret of at least 32 characters; blank disables reviewer APIs.
# scripts/run_local.py generates an ignored local key when this is blank.
SRA_REVIEW_TOKEN=
SRA_VISION_DAILY_LIMIT=100
SRA_VISION_CLIENT_DAILY_LIMIT=10
SRA_VISION_CLIENT_HOURLY_LIMIT=5
SRA_ROUTING_DAILY_LIMIT=500
SRA_ROUTING_CLIENT_DAILY_LIMIT=100
SRA_ROUTING_CLIENT_HOURLY_LIMIT=30

# Optional verified Macedonian encoder. Leave blank to download its fixed revision.
SRA_MULTILINGUAL_MODEL_PATH=
